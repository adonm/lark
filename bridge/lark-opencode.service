[Unit]
Description=Lark isolated OpenCode V2 API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/.local/share/lark/opencode/workspace
EnvironmentFile=%h/.config/lark/bridge.env
Environment="XDG_CONFIG_HOME=%h/.local/share/lark/opencode/config"
Environment="XDG_DATA_HOME=%h/.local/share/lark/opencode/data"
Environment="XDG_STATE_HOME=%h/.local/share/lark/opencode/state"
Environment="XDG_CACHE_HOME=%h/.local/share/lark/opencode/cache"
Environment=OPENCODE_DISABLE_PROJECT_CONFIG=1 OPENCODE_DISABLE_CLAUDE_CODE=1
# OpenCode logs HTTP paths, including the one-time code in redemption URLs.
Environment=OPENCODE_LOG_LEVEL=none
UnsetEnvironment=OPENCODE_CONFIG OPENCODE_CONFIG_DIR OPENCODE_CONFIG_CONTENT OPENCODE_DB OPENCODE_SERVER_USERNAME
ExecStartPre=/usr/bin/test -n "${OPENCODE_SERVER_PASSWORD}"
ExecStart="@OPENCODE_BIN@" serve --hostname 127.0.0.1 --port 49375
Restart=on-failure
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
