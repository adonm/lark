[Unit]
Description=Lark companion server (voice, companions, remote controls, OTA)
Wants=network-online.target lark-opencode.service
After=network-online.target lark-opencode.service

[Service]
Environment="LARK_DEVICE_PORT=8766"
Environment="MALLOC_ARENA_MAX=2"
EnvironmentFile=@ENV_FILE@
Environment="XDG_DATA_HOME=@DATA_HOME@"
Environment="LARK_REPO_DIR=@REPO_DIR@"
ExecStart="@LARK_BIN@" serve
Restart=on-failure
KillMode=mixed
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
