[Unit]
Description=Lark real-time media edge (terminals, capture, RTP, speech models)
Wants=network-online.target
After=network-online.target

[Service]
Environment="MALLOC_ARENA_MAX=2"
EnvironmentFile=@ENV_FILE@
Environment="LARK_DATA_DIR=@DATA_HOME@/lark"
ExecStart="@EDGE_BIN@"
Restart=on-failure
KillMode=mixed
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
